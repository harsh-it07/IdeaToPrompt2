# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-this-with-a-long-random-string

# ── AI Provider (NVIDIA NIM — OpenAI-compatible) ────────────
# Get a free key at https://build.nvidia.com
# NEVER commit your real key. This file is just a template.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=your-nvidia-api-key-here
AI_MODEL=deepseek-ai/deepseek-v4-pro

# Set to `local` to skip the AI API completely and use the built-in offline
# prompt engine (no key / internet needed). If left unset, the app tries the AI
# API first and falls back to the offline engine automatically.
AI_PROVIDER=local

# ── Database ─────────────────────────────────────────────
# Path to the SQLite file (defaults to server/data.sqlite if unset)
# DB_PATH=./data.sqlite
